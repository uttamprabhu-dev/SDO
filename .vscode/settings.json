{
    "git.enableSmartCommit": true,
    "files.autoSave": "afterDelay",
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/.git/objects/**": true,
        "**/*.log": true,
        "**/vendor/**": true,
        "**/target/**": true,
        "**/.venv/**": true,
        "**/env/**": true,
        "**/venv/**": true,
        "**/.husky/**": true,
        "**/.sfdx/**": true,
        "**/uiBundles/**": true
    },
    "search.exclude": {
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/.git/**": true,
        "**/vendor/**": true,
        "**/target/**": true,
        "**/.venv/**": true,
        "**/env/**": true,
        "**/venv/**": true,
        "**/.husky/**": true,
        "**/.sfdx/**": true,
        "**/uiBundles/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.vscode": false,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/node_modules": true,
        "node_modules": true,
        "venv": true,
        "**/.venv/**": true,
        "**/env/**": true,
        "**/venv/**": true,
        "*.sublime-*": true,
        "**/.husky/**": true,
        "**/.sfdx/**": true,
    },
    "continue.enableNextEdit": false
}